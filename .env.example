# Local development: embedded PostgreSQL, one Node.js process only.
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/postgres

# Generated locally by npm run auth:setup. Never commit the actual secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Password reset mail is saved to .data/mail for local demonstration only.

# For a standalone PostgreSQL server, set DB_DRIVER=postgres and DATABASE_URL.
# DATABASE_URL=postgresql://beatstore:password@localhost:5432/beatstore
