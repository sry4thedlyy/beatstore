{
  "name": "beatstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:postgres": "tsx --conditions=react-server --test tests/checkout.postgres.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts seed",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/database.ts setup",
    "demo:assets": "tsx scripts/generate-demo-assets.ts",
    "documents:preview": "tsx --conditions=react-server scripts/preview-licenses.ts",
    "auth:setup": "tsx scripts/setup-auth.ts",
    "account:demo": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/demo-account.ts",
    "mail:inbox": "tsx scripts/mail-inbox.ts",
    "account:admin": "node --env-file-if-exists=.env.local --import tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@electric-sql/pglite": "0.5.8",
    "@pdf-lib/fontkit": "1.1.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "music-metadata": "12.1.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
